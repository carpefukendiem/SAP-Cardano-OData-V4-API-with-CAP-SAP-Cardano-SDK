# SAP–Cardano OData V4 API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Cardano Network ─────────────────────────────────────────────────────────
# mainnet | preprod | preview
# Use preprod for development and testing (free test ADA, no real value)
CARDANO_NETWORK=preprod

# ── Blockfrost API Keys ──────────────────────────────────────────────────────
# Get your free key at https://blockfrost.io
# Create a project for each network you use.
BLOCKFROST_API_KEY_MAINNET=mainnetYOURKEYHERE
BLOCKFROST_API_KEY_PREPROD=preprodYOURKEYHERE
BLOCKFROST_API_KEY_PREVIEW=previewYOURKEYHERE

# ── Koios (optional) ─────────────────────────────────────────────────────────
# Koios is used automatically as a fallback — no key needed.
# Override the base URL if using a self-hosted Koios node.
# KOIOS_MAINNET_URL=https://api.koios.rest/api/v1
# KOIOS_PREPROD_URL=https://preprod.koios.rest/api/v1

# ── SAP CAP ─────────────────────────────────────────────────────────────────
PORT=4004
CDS_ENV=development

# ── Authentication (production only) ────────────────────────────────────────
# Leave empty for local development — auth is disabled in development mode.
# In production, bind the XSUAA service via CF and these are injected automatically.
# VCAP_SERVICES={}

# ── Contract Wallet Addresses ────────────────────────────────────────────────
# The Cardano addresses your organisation controls.
# These are PUBLIC addresses — safe to store in env.
# In production these come from your HSM / wallet.
CARDANO_COMPANY_ADDRESS_PREPROD=addr_test1qpkxr3kpzex93m646qr7w82d56md2kchtsv9jy39dykn4cmcxuuneyeqhdc4wy7de9mk54fndmckahxwqtwy3qg8pums5vlxhz
CARDANO_COMPANY_ADDRESS_MAINNET=

# ── Cache TTL (seconds) ──────────────────────────────────────────────────────
# How long to cache blockchain responses. Increase for lower latency,
# decrease for more up-to-date data.
CACHE_TTL_TX=60
CACHE_TTL_ADDRESS=15
CACHE_TTL_BLOCK=20
CACHE_TTL_EPOCH=300

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# debug | info | warn | error
